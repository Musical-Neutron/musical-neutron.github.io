---
import Layout from '~/layouts/PageLayout.astro';

import { PERSONAL } from 'astrowind:config';
import ImageCarousel from '~/components/ImageCarousel.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import NextTimelineEvent from '~/components/widgets/NextTimelineEvent.astro';
import { outreachEvents } from '~/data/events.js';
import Image from '~/components/common/Image.astro';
import headshot from '~/assets/images/oliver_newton.png';
import AboutMe from '~/content/about_me.md';
import { getNewsDisplayState } from '~/utils/newsDisplay';

const metadata = {
  title: 'Astrophysicist | Oliver Newton',
  ignoreTitleTemplate: true,
};

// While there is recent news, the "Latest news" section appears above About and the News
// button scrolls to it; otherwise both are hidden (see utils/newsDisplay.ts).
const latestNewsSectionId = 'latest-news';
const news = await getNewsDisplayState();

const heroActions = [
  { text: 'About me', href: '#about' },
  ...(news.isFresh ? [{ text: 'News', href: `#${latestNewsSectionId}` }] : []),
  { text: 'Research', href: '/research' },
  { text: 'Contact', href: '/contact' },
];
---

<Layout metadata={metadata}>
  {/* Outreach events happening now or in the next two weeks; hidden when there are none */}
  <NextTimelineEvent
    title="Events"
    items={outreachEvents}
    appearanceDelay={14}
    eventsPageLink={'/outreach'}
    classes={{ container: 'py-4! md:py-8! lg:py-10! mb-6!' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-(--aw-color-bg-alt) border-b border-(--aw-color-bg-page-dark)"></div>
    </Fragment>
  </NextTimelineEvent>

  {/* Hero Widget ******************* */}

  <Hero actions={heroActions} image="">
    <Fragment slot="title">
      <Image
        src={headshot}
        alt=""
        width={192}
        height={192}
        widths={[192, 384]}
        sizes="(max-width: 768px) 144px, 176px"
        format="webp"
        loading="eager"
        class="block mx-auto mb-6 w-36! h-36! md:w-44! md:h-44! rounded-full object-cover border-4 border-(--aw-color-bg-page-dark)"
      />
      Oliver Newton
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline rich-text">
        I'm a Marie Sk&lstrok;odowska&ndash;Curie Fellow in the
        <a href={PERSONAL.institutionURL}>{PERSONAL.institutionGroup}</a>
        at the
        <a href="https://www.surrey.ac.uk/">University of Surrey</a>, UK. My research focuses on using galaxies as tools
        to probe the nature of the Universe. At Surrey I am leading the
        <a href={PERSONAL.projectURL}>CWEBDWARFS</a> project connecting the physical mechanisms underpinning galaxy evolution
        with their large-scale cosmological environments.
      </span>
      <span class="block mb-1 sm:hidden">Marie Sk&lstrok;odowska&ndash;Curie Fellow<br />University of Surrey, UK</span>
    </Fragment>

    {
      /* <Fragment slot="bg">
      <div class="absolute inset-0 page-fade-dark"></div>
    </Fragment> */
    }
  </Hero>

  {/* Latest news: only while there is recent news (see utils/newsDisplay.ts) */}

  <BlogLatestPosts
    id={latestNewsSectionId}
    title="Latest news"
    information={`Latest articles and announcements relating to my research and outreach.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 page-fade-dark"></div>
    </Fragment>
  </BlogLatestPosts>

  {/* Content Widget **************** */}

  <Content id="about" isReversed tagline="" title="About" items={[]}>
    {/* Auto-scrolling image gallery */}
    <Fragment slot="image">
      <ImageCarousel
        images={[
          { src: '/images/peru.png', alt: 'Near the summit of El Misti, 2009' },
          { src: '/images/band_rah.png', alt: 'Reg Vardy brass band in the Royal Albert Hall, 2016' },
          // add more images as you like
        ]}
      />
    </Fragment>
    <Fragment slot="content">
      <div class="rich-text space-y-4 hyphens-auto md:text-justify">
        <AboutMe />
      </div>
    </Fragment>

    {
      /* <Fragment slot="bg">
      <div class="absolute inset-0 page-fade-light"></div>
    </Fragment> */
    }
  </Content>
</Layout>
