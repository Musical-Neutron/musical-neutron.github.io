---
import { Icon } from 'astro-icon/components';

type PressGalleryItem = {
  href: string;
  title: string;
  subtitle?: string;
  description?: string;
  icon?: string;
  image?: {
    src: string;
    alt?: string;
  };
};

const { items = [] }: { items?: PressGalleryItem[] } = Astro.props;
const hasItems = items && items.length > 0;
---

{hasItems ? (
  <div
    class="relative w-full"
    data-press-gallery
  >
    <div
      class="flex gap-4 py-10  overflow-x-auto overflow-y-visible scroll-snap-x mandatory scroll-snap-align-center"
      data-press-track
    >
      {items.map((item) => (
        <a
        href={item.href}
        class="press-card relative block w-64 h-40 shrink-0 rounded-lg overflow-hidden
             text-slate-900 dark:text-white
             transition-shadow transition-opacity
             scroll-snap-align-center"
        >
        {item.image ? (
            <>
            <img
                src={item.image.src}
                alt={item.image.alt ?? item.title}
                class="w-full h-full object-cover"
                loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
            </>
        ) : (
            <div class="absolute inset-0 bg-gradient-to-br
                      press-placeholder
                      dark:from-slate-700 dark:via-slate-600 dark:to-slate-800 " />
        )}

        <div class="absolute inset-0 flex flex-col justify-end p-3">
                {/* Icon in upper-right */}
            {item.icon && (
            <div class="absolute top-2 right-2">
                <Icon
                name={item.icon}
                class="w-4 h-4 text-slate-900 dark:text-white"
                />
            </div>
            )}
            <h3 class="text-sm font-semibold mb-1 line-clamp-2">
                {item.title}
            </h3>
            <p class="text-xs text-muted dark:text-muted line-clamp-3">
                <span class="font-semibold">{item.subtitle}</span>
                <br />
                <span>{item.description}</span>
            </p>
        </div>

        <!-- Internal highlight overlay -->
        <div
        class="press-card-highlight absolute inset-0 rounded-lg pointer-events-none opacity-0 z-10"
        ></div>
        </a>
      ))}
    </div>

    <!-- Navigation arrows -->
    <button
      type="button"
      class="absolute left-2 top-1/2 -translate-y-1/2 z-10 rounded-full btn-secondary press-gallery-button p-2 hover:bg-black/60"
      data-press-dir="prev"
      aria-label="Previous item"
    >
      ‹
    </button>
    <button
      type="button"
      class="absolute right-2 top-1/2 -translate-y-1/2 z-10 rounded-full btn-secondary press-gallery-button  p-2 hover:bg-black/60"
      data-press-dir="next"
      aria-label="Next item"
    >
      ›
    </button>
  </div>
) : null}


<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;

    const galleries = document.querySelectorAll('[data-press-gallery]');
    galleries.forEach(function (gallery) {
      const track = gallery.querySelector('[data-press-track]');
      if (!track) return;

      const slides = track.children;
      const total = slides.length;
      if (total === 0) return;

      let index = 0;
      let timer;
      const autoPlay = true;
      const interval = 8000;
      const pauseAfterInteraction = 5000;

      function scrollToIndex(idx, smooth) {
        if (total === 0) return;

        const activeSlide = slides[idx];
        const containerRect = track.getBoundingClientRect();
        const slideRect = activeSlide.getBoundingClientRect();

        const slideCenter = slideRect.left + slideRect.width / 2;
        const containerCenter = containerRect.left + containerRect.width / 2;
        const delta = slideCenter - containerCenter;

        track.scrollBy({
          left: delta,
          behavior: smooth ? 'smooth' : 'auto',
        });

        // Highlight active slide
        for (let i = 0; i < total; i++) {
          slides[i].classList.remove('press-active');
        }
        slides[idx].classList.add('press-active');
      }

      function startAutoPlay() {
        if (!autoPlay || total <= 1) return;
        clearInterval(timer);
        timer = setInterval(function () {
          index = (index + 1) % total;
          scrollToIndex(index, true);
        }, interval);
      }

      // Initial state
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          requestAnimationFrame(function () {
            scrollToIndex(index, false);
            startAutoPlay();
          });
        });
      } else {
        requestAnimationFrame(function () {
          scrollToIndex(index, false);
          startAutoPlay();
        });
      }

      window.addEventListener('resize', function () {
        scrollToIndex(index, false);
      });

      const buttons = gallery.querySelectorAll('[data-press-dir]');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const dir = btn.getAttribute('data-press-dir');
          if (dir === 'prev') {
            index = (index - 1 + total) % total;
          } else {
            index = (index + 1) % total;
          }
          scrollToIndex(index, true);

          clearInterval(timer);
          if (autoPlay && total > 1) {
            setTimeout(startAutoPlay, pauseAfterInteraction);
          }
        });
      });

      // Optional: track scroll to update index based on the centered slide
      track.addEventListener('scroll', function () {
        // You can implement an index update based on current scroll position if you like,
        // but it's not strictly necessary if you only care about visual behavior.
      });
    });
  })();
</script>
