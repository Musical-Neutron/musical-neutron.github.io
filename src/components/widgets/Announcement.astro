---
// The strip across the top of every page, set in the site editor (src/data/announcement.json)
import announcement from '~/data/announcement.json';
import { getPermalink } from '~/utils/permalinks';

const {
  enabled = false,
  badgeText = '',
  text = '',
  link = '',
  startsAt = '',
  expiresAt = '',
}: {
  enabled?: boolean;
  badgeText?: string;
  text?: string;
  link?: string;
  startsAt?: string;
  expiresAt?: string;
} = announcement;

// "Show from": the bar only goes into the site at the first build after this time, so an
// announcement of something embargoed isn't in the pages early
const startDate = startsAt ? new Date(startsAt) : null;
const notStarted = startDate !== null && !Number.isNaN(startDate.getTime()) && startDate > new Date();

// "Hide after": checked when the site is built, and again in the browser (the script below),
// because the site is only rebuilt every few hours
const parsed = expiresAt ? new Date(expiresAt) : null;
const expiry = parsed && !Number.isNaN(parsed.getTime()) ? parsed : null;
const isExpired = expiry !== null && expiry <= new Date();

// A page on this site ("/outreach") is turned into a site link; a full web address is used as it is
const href = link ? (link.startsWith('/') ? getPermalink(link) : link) : '';
---

{
  enabled && text && !notStarted && !isExpired && (
    <div class="announcement-bar" data-announcement data-expires={expiry?.toISOString()}>
      <div class="hidden md:flex sidebar-offset gap-1 overflow-hidden px-3 py-2 text-sm text-muted relative text-ellipsis whitespace-nowrap bg-(--aw-color-page-dark)">
        {badgeText && (
          <span class="announcement-badge font-semibold px-1 py-0.5 text-xs mr-0.5 rtl:mr-0 rtl:ml-0.5 inline-block">
            {badgeText}
          </span>
        )}
        {href ? (
          <a href={href} class="text-muted font-medium">
            {text}
          </a>
        ) : (
          <span class="text-muted font-medium">{text}</span>
        )}
      </div>
    </div>
  )
}

<script is:inline>
  document.querySelectorAll('[data-announcement][data-expires]').forEach((bar) => {
    if (new Date(bar.dataset.expires) <= new Date()) bar.remove();
  });
</script>
