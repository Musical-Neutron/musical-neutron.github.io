            class="hover:bg-(--press-highlight-1) focus:outline-none focus:ring-4 focus:ring-(--press-highlight-1) rounded-lg text-sm p-2.5 inline-flex items-center gap-1"
            aria-label="RSS Feed"
            target="_blank"
            rel="noopener noreferrer"
            href={getAsset('/rss.xml')}
          >
            <Icon name="tabler:rss" class="w-4 h-4" />
          </a>
        )}
      </div>
      {actions?.length ? (
        <div class="flex gap-2">
          {actions.map((btnProps) => (
            <Button
              {...btnProps}
              class="py-1.5 px-3 font-semibold shadow-none text-xs w-auto"
            />
          ))}
        </div>
      ) : null}
    </div>
  </div>
</aside>

