    <!-- Navigation -->
  <nav class="sidebar-nav-background flex-1 overflow-y-auto mt-2" aria-label="Main navigation">
    <ul class="flex flex-col px-2">
      {enhancedNavLinks.map((item, index) => (
        <li class="mb-2">
          <div class="pb-1">
            {/* Parent link */}
            <a
              href={item.href ?? '#'}
              class:list={[
                'sidebar-nav-link flex w-full items-center justify-between px-2 py-1 font-bold whitespace-nowrap rounded-lg',
                { 'aw-link-active': item.href === currentPath },
              ]}
            >
              <span>{item.text}</span>
            </a>

            {/* Child links, if any */}
            {item.links?.length ? (
              <ul class="mt-1 ml-3 space-y-1">
                {item.links.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={[
                        'sidebar-sub-link block px-2 py-1 text-xs whitespace-normal rounded-lg',
                        { 'aw-link-active': child.href === currentPath },
                      ]}
                    >
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
          {/* Narrow divider */}
          <div class="mt-1">
            <div class="mx-1 pb-2 border-b border-(--aw-color-primary)" />
          </div>
        </li>
      ))}
    </ul>
  </nav>
  
  <!-- Bottom: theme toggle, RSS, actions -->
  <div class="px-4 py-3 sidebar-foot-background">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        {showToggleTheme && (
          <ToggleTheme iconClass="w-5 h-5 md:inline-block" />
        )}
        {showRssFeed && (
