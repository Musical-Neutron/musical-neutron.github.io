---
import { APP_BLOG } from 'astrowind:config';

import Grid from '~/components/blog/Grid.astro';

import { getBlogPermalink } from '~/utils/permalinks';
import { getNewsDisplayState } from '~/utils/newsDisplay';
import { fetchPosts } from '~/utils/blog';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';
import Button from '~/components/ui/Button.astro';

export interface Props extends Widget {
  title?: string;
  linkText?: string;
  linkUrl?: string | URL;
  information?: string;
  count?: number;
  freshnessDays?: number;
  maxAgeDays?: number;
}

const {
  title = await Astro.slots.render('title'),
  linkText = 'View all news',
  linkUrl = getBlogPermalink(),
  information = await Astro.slots.render('information'),
  count = APP_BLOG.latest?.minCount ?? 4,
  freshnessDays = APP_BLOG.latest?.freshnessDays ?? 30,
  maxAgeDays = APP_BLOG.latest?.maxAgeDays ?? 365,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const allPosts = APP_BLOG.isEnabled ? await fetchPosts() : [];
const now = new Date();
const dayMs = 1000 * 60 * 60 * 24;

// Posts newer than freshnessDays (X)
const freshPosts = allPosts.filter(
  (post) => now.getTime() - post.publishDate.getTime() <= freshnessDays * dayMs
);

// If no fresh posts, hide the widget (posts = [])
const ageFilteredPosts =
  freshPosts.length > 0
    ? allPosts.filter(
        (post) => now.getTime() - post.publishDate.getTime() <= maxAgeDays * dayMs
      )
    : [];

const posts = ageFilteredPosts.slice(0, count);
---

{
  APP_BLOG.isEnabled && posts.length ? (
    <WidgetWrapper id={id} isDark={isDark} containerClass={classes?.container as string} bg={bg}>
      <div class="flex flex-col lg:justify-between lg:flex-row mb-8 rich-text">
        {title && (
          <div class="md:max-w-sm">
            <h2
              class="text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none group font-heading mb-2"
              set:html={title}
            />
            {APP_BLOG.list.isEnabled && linkText && linkUrl && (
              <Button variant="link" href={linkUrl}>
                {' '}
                {linkText} »
              </Button>
            )}
          </div>
        )}

        {information && <p class="lg:text-sm lg:max-w-md text-justify" set:html={information} />}
      </div>

      <Grid posts={posts} />
    </WidgetWrapper>
  ) : (
    <Fragment />
  )
}
