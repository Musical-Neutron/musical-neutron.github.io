---
import Image from '~/components/common/Image.astro';
import Timeline from '~/components/ui/EventTimeline.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Steps } from '~/types';

export interface Props extends Steps {
  // Passed on to the timeline: whether to show each event's category label.
  showCategory?: boolean;
}
import { categorizeEvents } from '~/utils/eventUtils';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  image = await Astro.slots.render('image'),
  isReversed = false,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
  showCategory = true,
} = Astro.props;

const { ongoingEvents, upcomingEvents, pastEvents } = categorizeEvents(items);

// Sort ongoing events in reverse chronological order (newest first)
ongoingEvents.sort((a, b) => b.start_date.getTime() - a.start_date.getTime());

// Sort upcoming events chronologically (oldest first)
upcomingEvents.sort((a, b) => a.start_date.getTime() - b.start_date.getTime());

// Sort past events in reverse chronological order (newest first)
pastEvents.sort((a, b) => b.start_date.getTime() - a.start_date.getTime());
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl ${classes?.container ?? ''}`} bg={bg}>
  <div class:list={['flex flex-col gap-8 md:gap-12', { 'md:flex-row-reverse': isReversed }, { 'md:flex-row': image }]}>
    <div class:list={['md:py-4 md:self-center', { 'md:basis-1/2': image }, { 'w-full': !image }]}>
      <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container: 'text-left rtl:text-right',
          title: 'text-3xl lg:text-4xl',
          ...((classes?.headline as object) ?? {}),
        }}
      />

      <div data-events-timeline>
        {/* Ongoing Events */}
        <div class="mb-8" data-events-section="ongoing" hidden={ongoingEvents.length === 0}>
          <h3 class="text-2xl font-bold mb-4">Ongoing Events</h3>
          <Timeline
            items={ongoingEvents}
            classes={classes?.items as Record<string, never>}
            showCategory={showCategory}
          />
        </div>

        {/* Upcoming Events */}
        <div class="mb-8" data-events-section="upcoming" hidden={upcomingEvents.length === 0}>
          <h3 class="text-2xl font-bold mb-4">Upcoming Events</h3>
          <Timeline
            items={upcomingEvents}
            classes={classes?.items as Record<string, never>}
            showCategory={showCategory}
          />
        </div>

        {/* Past Events */}
        <div data-events-section="past" hidden={pastEvents.length === 0}>
          <h3 class="text-2xl font-bold mb-4">Past Events</h3>
          <Timeline items={pastEvents} classes={classes?.items as Record<string, never>} showCategory={showCategory} />
        </div>
      </div>
    </div>

    {/* Optional Image */}
    {
      image && (
        <div class="relative md:basis-1/2">
          {typeof image === 'string' ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="inset-0 object-cover object-top w-full rounded-md shadow-lg md:absolute md:h-full bg-gray-400 dark:bg-slate-700"
              widths={[400, 768]}
              sizes="(max-width: 768px) 100vw, 432px"
              width={432}
              height={768}
              layout="cover"
              src={image?.src}
              alt={image?.alt || ''}
            />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>

<script>
  // The site is rebuilt every few hours, so an event can start or finish after the page was built.
  // When the page loads, move each event into the section that matches the current time.
  const refreshEventSections = () => {
    const now = Date.now();
    document.querySelectorAll<HTMLElement>('[data-events-timeline]').forEach((timeline) => {
      const lists: Record<string, HTMLElement | null> = {};
      for (const status of ['ongoing', 'upcoming', 'past']) {
        lists[status] = timeline.querySelector(`[data-events-section="${status}"] [data-events-list]`);
      }
      let moved = false;
      timeline.querySelectorAll<HTMLElement>('[data-event-item]').forEach((item) => {
        const start = Number(item.dataset.start);
        const end = Number(item.dataset.end);
        const status = now >= end ? 'past' : now >= start ? 'ongoing' : 'upcoming';
        const list = lists[status];
        if (list && item.parentElement !== list) {
          list.append(item);
          moved = true;
        }
      });
      if (!moved) return;
      for (const [status, list] of Object.entries(lists)) {
        if (!list) continue;
        // Upcoming: soonest first. Ongoing and past: most recent first.
        const items = [...list.children] as HTMLElement[];
        items.sort((a, b) => (Number(a.dataset.start) - Number(b.dataset.start)) * (status === 'upcoming' ? 1 : -1));
        list.append(...items);
        const section = list.closest<HTMLElement>('[data-events-section]');
        if (section) section.hidden = items.length === 0;
      }
    });
  };
  refreshEventSections();
  document.addEventListener('astro:page-load', refreshEventSections);
</script>
