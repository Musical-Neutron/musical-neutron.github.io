---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import JobMovePlaceholder from '~/components/JobMovePlaceholder.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);
const hasImage = !!image;
const isJobMove = (post as any).isJobMove === true;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class="mb-6 transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade rich-text"
>
  <!-- Card wrapper -->
  <div
    class="press-card relative md:h-64 rounded-lg overflow-hidden mb-6 press-placeholder transition-shadow transition-opacity"
  >
    {hasImage ? (
      link ? (
        <a href={link} class="block w-full h-full">
          <Image
            src={image}
            alt={post.title}
            class="w-full md:h-full object-cover"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 100vw, 900px"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
        </a>
      ) : (
        <>
          <Image
            src={image}
            alt={post.title}
            class="w-full md:h-full object-cover"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 100vw, 900px"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
        </>
      )
    ) : isJobMove ? (
      <!-- Job/country move: special placeholder -->
      <div class="flex items-center justify-center w-full h-full">
        <JobMovePlaceholder class="max-w-full max-h-full" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
      </div>
    ) : link ? (
      <!-- No image: clickable placeholder -->
      <a href={link} class="block w-full h-full">
        <div class="absolute inset-0 press-placeholder" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
      </a>
    ) : (
      <!-- No image and no link: non-clickable placeholder -->
      <>
        <div class="absolute inset-0 press-placeholder" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
      </>
    )}
  </div>

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading">
    {link ? (
      <a class="inline-block transition ease-in duration-200 hover:underline" href={link}>
        {post.title}
      </a>
    ) : (
      post.title
    )}
  </h3>

  <div class="mb-2 text-xs text-muted">
    <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 mr-1" />
    <time datetime={String(post.publishDate)} class="inline-block">
      {getFormattedDate(post.publishDate)}
    </time>
  </div>

  <p class="text-muted text-lg text-justify">{post.excerpt}</p>
</article>
