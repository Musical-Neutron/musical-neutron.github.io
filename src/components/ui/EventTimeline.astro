---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { Item } from '~/types';
import { formatDateRange } from '~/utils/dateUtils';

export interface Props {
  items?: Array<Item>;
  defaultIcon?: string;
  classes?: Record<string, string>;
  // Show each event's category label (e.g. "Seminar"); pages listing a single category can turn it off.
  showCategory?: boolean;
}

const { items = [], classes = {}, defaultIcon, showCategory = true } = Astro.props as Props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary border-primary',
} = classes;

const categoryBadgeStyles: Record<string, string> = {
  conference: 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-200',
  outreach: 'bg-(--aw-color-bg-page-dark) text-default dark:bg-green-900 dark:text-green-300',
  paper: 'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300',
  seminar: 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  milestone: 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300',
};
const categoryLabels: Record<string, string> = {
  conference: 'Conference',
  outreach: 'Outreach',
  paper: 'Paper',
  seminar: 'Seminar',
  milestone: 'Milestone',
};
---

{/* Always rendered, even when empty, so the script in EventsTimeline.astro can move events into it. */}
<div class={containerClass} data-events-list>
  {
    items.map(
      ({
        eventID,
        title,
        category,
        description,
        icon,
        start_date,
        end_date,
        start_time_flag,
        end_time_flag,
        timezone,
        month_only,
        location,
        info_link,
        location_link,
        start_ms,
        end_ms,
        classes: itemClasses = {},
      }) => (
        <div
          data-event-item
          data-start={start_ms}
          data-end={end_ms}
          class={twMerge(
            'group/event flex intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
            panelClass,
            itemClasses?.panel
          )}
        >
          {eventID && (
            <div
              id={eventID}
              class="relative -top-24 pointer-events-none invisible"
              style="height: 0; z-index: -1;"
              aria-hidden="true"
            />
          )}
          <div class="flex flex-col items-center mr-4 rtl:mr-0 rtl:ml-4">
            <div>
              <div class="flex items-center justify-center">
                {(icon || defaultIcon) && (
                  <Icon
                    name={icon || defaultIcon}
                    class={twMerge('w-10 h-10 p-2 rounded-full border-2', defaultIconClass, itemClasses?.icon)}
                  />
                )}
              </div>
            </div>
            <div class="w-px h-full bg-black/10 dark:bg-slate-400/50 group-last/event:hidden" />
          </div>
          <div class="pt-1 pb-8 group-last/event:pb-0">
            {title && <p class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)} set:html={title} />}
            {showCategory && category && (
              <span
                class={twMerge(
                  'text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full',
                  categoryBadgeStyles[category] ?? 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-200'
                )}
              >
                {categoryLabels[category] ?? category}
              </span>
            )}
            {/* Display Date and Location */}
            {(start_date || location) && (
              <p class={twMerge('text-sm text-muted mt-1', itemClasses?.description)}>
                {start_date && (
                  <span>
                    {formatDateRange(
                      start_date,
                      end_date,
                      start_time_flag,
                      end_time_flag,
                      timezone,
                      'en-GB',
                      month_only
                    )}
                  </span>
                )}
                {start_date && location && <span class="mx-2">•</span>}
                {location &&
                  (location_link ? (
                    <a
                      href={location_link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:text-accent transition-colors"
                    >
                      {location}
                    </a>
                  ) : (
                    <span>{location}</span>
                  ))}
              </p>
            )}

            {description && (
              <p
                class={twMerge('text-default mt-2', descriptionClass, itemClasses?.description)}
                set:html={description}
              />
            )}

            {/* Display Info Link if Provided */}
            {info_link && (
              <p class="mt-2 rich-text">
                <a href={info_link} target="_blank" rel="noopener noreferrer">
                  More information
                </a>
              </p>
            )}
          </div>
        </div>
      )
    )
  }
</div>
