---
import type { ItemGrid as Props } from '~/types';
import { twMerge } from 'tailwind-merge';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

const { items = [], columns, defaultIcon = '', classes = {} } = Astro.props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary',
  action: actionClass = '',
} = classes;
---

{items && (
  <div
    class={twMerge(
      `grid mx-auto gap-8 md:gap-y-8 ${
        columns === 4
          ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
          : columns === 3
            ? 'lg:grid-cols-3 sm:grid-cols-2'
            : columns === 2
              ? 'sm:grid-cols-2 '
              : ''
      }`,
      containerClass
    )}
  >
    {items.map(({ title, description, icon, cssIconClass, href, callToAction, classes: itemClasses = {} }) => (
      <div class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div class={twMerge('flex flex-row max-w-md', panelClass, itemClasses?.panel)}>
          {/* Icon */}
          <div class="flex justify-center">
            {(cssIconClass || icon || defaultIcon) && (
              cssIconClass ? (
                <div class="flex items-center justify-center w-7 h-7 mr-2 rtl:mr-0 rtl:ml-2">
                  <i
                    class={twMerge(cssIconClass, defaultIconClass, itemClasses?.icon)}
                    aria-hidden="true"
                  ></i>
                </div>
              ) : (
                <Icon
                  name={icon || defaultIcon}
                  class={twMerge('w-7 h-7 mr-2 rtl:mr-0 rtl:ml-2', defaultIconClass, itemClasses?.icon)}
                />
              )
            )}
          </div>

          {/* Text */}
          <div class="mt-0.5">
            {href ? (
              // Make title clickable in rich-text style when href is present
              <a href={href} class="rich-text inline-block">
                {title && (
                  <h3 class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)}>
                    {title}
                  </h3>
                )}
              </a>
            ) : (
              title && (
                <h3 class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)}>
                  {title}
                </h3>
              )
            )}

            {description && (
              <p
                class={twMerge(`${title ? 'mt-3' : ''} text-muted rich-text`, descriptionClass, itemClasses?.description)}
                set:html={description}
              />
            )}

            {callToAction && (
              <div
                class={twMerge(
                  `${title || description ? 'mt-3' : ''} flex flex-wrap gap-3 rich-text`,
                  actionClass,
                  itemClasses?.actionClass
                )}
              >
                {Array.isArray(callToAction) ? (
                  callToAction.map((action) => (
                    <Button variant="link" {...action} />
                  ))
                ) : (
                  <Button variant="link" {...callToAction} />
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
)}
