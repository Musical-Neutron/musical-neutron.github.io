---
import Button from '~/components/ui/Button.astro';
import type { Form as Props } from '~/types';

const { inputs, textarea, disclaimer, button = 'Send', description = '', action, recaptchaSiteKey } = Astro.props;
---

<form method="post" action={action} class="w-full">
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '' }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                class="py-3 px-4 block w-full text-md rounded-lg border border-(--aw-color-secondary) "
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class="py-3 px-4 block w-full text-md rounded-lg border border-(--aw-color-secondary) "
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            required
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-(--aw-color-secondary) "
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm ">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  { /* reCAPTCHA widget */
  recaptchaSiteKey && (
    <div class="mt-6">
      <div class="g-recaptcha" data-sitekey={recaptchaSiteKey} aria-hidden="true"></div>
    </div>
  )}

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm ">{description}</p>
      </div>
    )
  }
</form>
